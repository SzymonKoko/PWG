# Writes the git commit and dirty flag of the PWG sources into a header (Debug View metadata, D-09).
#
# Run as a script before every build of PWG (custom target PWG_build_info in CMakeLists.txt), so the values
# describe the sources at build time, not at configure time. The header is rewritten only when its content
# changes; then only src/debug/runMetadata.cpp, which includes it, is recompiled.
#
# Inputs: GIT_EXECUTABLE (may be empty), SOURCE_DIR, OUTPUT.
# pwg_dirty counts changes to tracked files only (git status --porcelain --untracked-files=no): untracked
# files such as local texture folders do not take part in the build.

set(PWG_GIT_COMMIT "unknown")
set(PWG_GIT_DIRTY -1)

if(GIT_EXECUTABLE)
	execute_process(
		COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD
		WORKING_DIRECTORY "${SOURCE_DIR}"
		RESULT_VARIABLE commitResult
		OUTPUT_VARIABLE commitOutput
		ERROR_QUIET
		OUTPUT_STRIP_TRAILING_WHITESPACE)
	if(commitResult EQUAL 0 AND commitOutput)
		set(PWG_GIT_COMMIT "${commitOutput}")
		execute_process(
			COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=no
			WORKING_DIRECTORY "${SOURCE_DIR}"
			RESULT_VARIABLE statusResult
			OUTPUT_VARIABLE statusOutput
			ERROR_QUIET
			OUTPUT_STRIP_TRAILING_WHITESPACE)
		if(statusResult EQUAL 0)
			if(statusOutput)
				set(PWG_GIT_DIRTY 1)
			else()
				set(PWG_GIT_DIRTY 0)
			endif()
		endif()
	endif()
endif()

set(content "// Generated by cmake/pwgBuildInfo.cmake at build time. Do not edit.\n")
string(APPEND content "#pragma once\n")
string(APPEND content "#define PWG_GIT_COMMIT \"${PWG_GIT_COMMIT}\"\n")
string(APPEND content "#define PWG_GIT_DIRTY ${PWG_GIT_DIRTY}\n")

set(existing "")
if(EXISTS "${OUTPUT}")
	file(READ "${OUTPUT}" existing)
endif()
if(NOT existing STREQUAL content)
	file(WRITE "${OUTPUT}" "${content}")
	message(STATUS "PWG build info: ${PWG_GIT_COMMIT} dirty=${PWG_GIT_DIRTY}")
endif()
