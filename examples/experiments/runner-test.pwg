  NormalMaskPass: ~
  SlopeMaskPass: ~
terrainGraphV2:
  schemaVersion: 5
  useUniversalGraph: true
  pan: { x: 40, y: 40 }
  zoom: 0.8
  nextNodeId: 10
  nextLinkId: 5
  nodes:
    - id: 1
      typeId: noiseHeight
      displayName: Base Noise
      enabled: true
      position: { x: 0, y: 0 }
      parameters:
        - { id: seed, int: 42 }
        - { id: octaves, int: 5 }
    - id: 2
      typeId: particleErosion
      displayName: Particle Erosion
      enabled: true
      position: { x: 300, y: 0 }
      parameters:
        - { id: amount, float: 0.35, min: 0, max: 1 }
        - { id: seed, int: 1337 }
    - id: 3
      typeId: thermalErosion
      displayName: Thermal Erosion
      enabled: true
      position: { x: 600, y: 0 }
      parameters:
        - { id: amount, float: 0.35, min: 0, max: 1 }
    - id: 4
      typeId: outputHeight
      displayName: Output Height
      enabled: true
      position: { x: 900, y: 0 }
    - id: 5
      typeId: drainageNetwork
      displayName: Drainage
      enabled: true
      position: { x: 0, y: 220 }
    - id: 6
      typeId: grassAsset
      displayName: Grass
      enabled: true
      position: { x: 300, y: 220 }
    - id: 7
      typeId: treeAssetA
      displayName: Tree A
      enabled: true
      position: { x: 600, y: 220 }
    - id: 8
      typeId: treeAssetB
      displayName: Tree B
      enabled: false
      position: { x: 900, y: 220 }
    - id: 9
      typeId: fitRange
      displayName: Height Amplitude
      enabled: true
      position: { x: 150, y: 120 }
      parameters:
        - { id: inMin, float: 0, min: -20000, max: 20000 }
        - { id: inMax, float: 1, min: -20000, max: 20000 }
        - { id: outMin, float: 0, min: -20000, max: 20000 }
        - { id: outMax, float: 300, min: -20000, max: 20000 }
  links:
    - { id: 1, fromNodeId: 1, fromPortId: height, toNodeId: 9, toPortId: value }
    - { id: 4, fromNodeId: 9, fromPortId: result, toNodeId: 2, toPortId: height }
    - { id: 2, fromNodeId: 2, fromPortId: height, toNodeId: 3, toPortId: height }
    - { id: 3, fromNodeId: 3, fromPortId: height, toNodeId: 4, toPortId: height }
