#version 450 core

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout (r32f, binding = 0) writeonly uniform image2D u_output;

uniform sampler2D u_value;
uniform int u_size;
uniform int u_operation; // 0 clamp, 1 normalize, 2 power, 3 threshold, 4 abs, 5 invert, 6 fit range, 7 smoothstep, 8 terrace, 9 posterize
uniform float u_min;
uniform float u_max;
uniform float u_power;
uniform float u_outMin;
uniform float u_outMax;
uniform int u_steps;

void main()
{
    ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy);
    if (texelCoord.x >= u_size || texelCoord.y >= u_size)
        return;

    float v = texelFetch(u_value, texelCoord, 0).r;
    float result = v;
    if (u_operation == 0)
        result = clamp(v, u_min, u_max);
    else if (u_operation == 1)
        result = clamp((v - u_min) / max(u_max - u_min, 0.0001), 0.0, 1.0);
    else if (u_operation == 2)
        result = pow(max(v, 0.0), max(u_power, 0.0001));
    else if (u_operation == 3)
        result = smoothstep(u_min, u_max, v);
    else if (u_operation == 4)
        result = abs(v);
    else if (u_operation == 5)
        result = u_power - v;
    else if (u_operation == 6)
    {
        float t = clamp((v - u_min) / max(u_max - u_min, 0.0001), 0.0, 1.0);
        result = mix(u_outMin, u_outMax, t);
    }
    else if (u_operation == 7)
        result = smoothstep(u_min, u_max, v);
    else if (u_operation == 8)
    {
        float t = clamp((v - u_min) / max(u_max - u_min, 0.0001), 0.0, 1.0);
        float steps = float(max(u_steps, 2));
        result = mix(u_min, u_max, floor(t * (steps - 1.0)) / max(steps - 1.0, 1.0));
    }
    else if (u_operation == 9)
    {
        float steps = float(max(u_steps, 2));
        result = floor(clamp(v, 0.0, 1.0) * (steps - 1.0)) / max(steps - 1.0, 1.0);
    }

    imageStore(u_output, texelCoord, vec4(result, 0.0, 0.0, 1.0));
}
