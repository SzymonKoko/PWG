#version 450 core

layout (local_size_x = 8, local_size_y = 8) in;

layout (r32f, binding = 0) writeonly uniform image2D u_heightOut;
layout (r32f, binding = 1) writeonly uniform image2D u_sedimentOut;
layout (r32f, binding = 2) writeonly uniform image2D u_depositOut;
layout (r32f, binding = 3) writeonly uniform image2D u_erosionDelta;

uniform sampler2D u_heightIn;
uniform sampler2D u_baseHeight;
uniform sampler2D u_waterIn;
uniform sampler2D u_sedimentIn;
uniform sampler2D u_flux;
uniform sampler2D u_diagonalFlux;
uniform sampler2D u_riverChannelsIn;
uniform sampler2D u_flowAccumulationIn;
uniform sampler2D u_depositIn;

uniform int u_size;
uniform float u_sedimentCapacity;
uniform float u_erosionStrength;
uniform float u_depositionStrength;
uniform float u_minWaterToErode;
uniform float u_minFlowToErode;
uniform float u_maxHeightChange;
uniform float u_maxErosionDepth;
uniform float u_maxDepositHeight;
uniform float u_riverChannelInfluence;
uniform float u_riverChannelDepth;
uniform float u_flatteningStrength;

ivec2 ClampCoord(ivec2 p)
{
    return clamp(p, ivec2(0), ivec2(u_size - 1));
}

bool IsInside(ivec2 p)
{
    return p.x >= 0 && p.y >= 0 && p.x < u_size && p.y < u_size;
}

float HeightAt(ivec2 p)
{
    return texelFetch(u_heightIn, ClampCoord(p), 0).r;
}

float BaseHeightAt(ivec2 p)
{
    return texelFetch(u_baseHeight, ClampCoord(p), 0).r;
}

float WaterAt(ivec2 p)
{
    return texelFetch(u_waterIn, ClampCoord(p), 0).r;
}

float SedimentAt(ivec2 p)
{
    return texelFetch(u_sedimentIn, ClampCoord(p), 0).r;
}

float DepositAt(ivec2 p)
{
    return texelFetch(u_depositIn, ClampCoord(p), 0).r;
}

float RiverChannelAt(ivec2 p)
{
    return texelFetch(u_riverChannelsIn, ClampCoord(p), 0).r;
}

vec4 FluxAt(ivec2 p)
{
    if (!IsInside(p))
        return vec4(0.0);

    return max(texelFetch(u_flux, p, 0), vec4(0.0));
}

vec4 DiagonalFluxAt(ivec2 p)
{
    if (!IsInside(p))
        return vec4(0.0);

    return max(texelFetch(u_diagonalFlux, p, 0), vec4(0.0));
}

float SurfaceAt(ivec2 p)
{
    float channelCut = RiverChannelAt(p) * u_riverChannelInfluence * u_riverChannelDepth;
    return HeightAt(p) - channelCut + WaterAt(p);
}

float OutWaterAt(ivec2 id)
{
    vec4 f = FluxAt(id);
    vec4 df = DiagonalFluxAt(id);
    return f.x + f.y + f.z + f.w + df.x + df.y + df.z + df.w;
}

float InWaterAt(ivec2 id)
{
    float incoming = 0.0;
    incoming += FluxAt(id + ivec2(-1, 0)).y;
    incoming += FluxAt(id + ivec2(1, 0)).x;
    incoming += FluxAt(id + ivec2(0, -1)).w;
    incoming += FluxAt(id + ivec2(0, 1)).z;
    incoming += DiagonalFluxAt(id + ivec2(-1, -1)).w;
    incoming += DiagonalFluxAt(id + ivec2(1, -1)).z;
    incoming += DiagonalFluxAt(id + ivec2(-1, 1)).y;
    incoming += DiagonalFluxAt(id + ivec2(1, 1)).x;
    return incoming;
}

float SedimentTransportFrom(ivec2 from, float incomingWater)
{
    float sourceWater = max(WaterAt(from), 0.000001);
    return SedimentAt(from) * clamp(incomingWater / sourceWater, 0.0, 1.0);
}

float IncomingSedimentAt(ivec2 id)
{
    float sediment = 0.0;
    sediment += SedimentTransportFrom(id + ivec2(-1, 0), FluxAt(id + ivec2(-1, 0)).y);
    sediment += SedimentTransportFrom(id + ivec2(1, 0), FluxAt(id + ivec2(1, 0)).x);
    sediment += SedimentTransportFrom(id + ivec2(0, -1), FluxAt(id + ivec2(0, -1)).w);
    sediment += SedimentTransportFrom(id + ivec2(0, 1), FluxAt(id + ivec2(0, 1)).z);
    sediment += SedimentTransportFrom(id + ivec2(-1, -1), DiagonalFluxAt(id + ivec2(-1, -1)).w);
    sediment += SedimentTransportFrom(id + ivec2(1, -1), DiagonalFluxAt(id + ivec2(1, -1)).z);
    sediment += SedimentTransportFrom(id + ivec2(-1, 1), DiagonalFluxAt(id + ivec2(-1, 1)).y);
    sediment += SedimentTransportFrom(id + ivec2(1, 1), DiagonalFluxAt(id + ivec2(1, 1)).x);
    return sediment;
}

float DownhillSlope(ivec2 id)
{
    float surface = SurfaceAt(id);
    float best = 0.0;
    best = max(best, surface - SurfaceAt(id + ivec2(-1, 0)));
    best = max(best, surface - SurfaceAt(id + ivec2(1, 0)));
    best = max(best, surface - SurfaceAt(id + ivec2(0, -1)));
    best = max(best, surface - SurfaceAt(id + ivec2(0, 1)));
    best = max(best, (surface - SurfaceAt(id + ivec2(-1, -1))) * 0.70710678);
    best = max(best, (surface - SurfaceAt(id + ivec2(1, -1))) * 0.70710678);
    best = max(best, (surface - SurfaceAt(id + ivec2(-1, 1))) * 0.70710678);
    best = max(best, (surface - SurfaceAt(id + ivec2(1, 1))) * 0.70710678);
    return max(best, 0.0);
}

float ThermalTransfer(float h, float hn)
{
    // Only the part of the height difference above the talus angle is allowed to move.
    // Positive => neighbour is higher (material slides in), negative => we are higher
    // (material slides out). This is the classic gravity-driven thermal weathering.
    const float talus = 0.0035;
    float d = hn - h;
    float a = abs(d);
    if (a <= talus)
        return 0.0;
    return sign(d) * (a - talus);
}

void main()
{
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    if (id.x >= u_size || id.y >= u_size)
        return;

    float originalHeight = HeightAt(id);
    float height = originalHeight;
    float baseHeight = BaseHeightAt(id);
    float water = WaterAt(id);
    float sediment = SedimentAt(id);
    float deposit = DepositAt(id);
    float outWater = OutWaterAt(id);
    float inWater = InWaterAt(id);

    float transportedSedimentOut = sediment * clamp(outWater / max(water, 0.000001), 0.0, 1.0);
    float transportedSedimentIn = IncomingSedimentAt(id);
    float newSediment = max(sediment + transportedSedimentIn - transportedSedimentOut, 0.0);

    float flow = inWater + outWater;
    float velocity = flow / max(flow + water, 0.000001);
    float slope = DownhillSlope(id);
    float waterFactor = smoothstep(u_minWaterToErode, u_minWaterToErode + 0.05, water);
    float flowFactor = smoothstep(u_minFlowToErode, u_minFlowToErode + 0.08, flow);
    float channelBoost = 1.0 + RiverChannelAt(id) * u_riverChannelInfluence;

    float capacity = u_sedimentCapacity * velocity * max(slope, 0.002) * waterFactor * flowFactor * channelBoost;
    float heightDelta = 0.0;

    if (capacity > newSediment && flowFactor > 0.0)
    {
        float eroded = min((capacity - newSediment) * u_erosionStrength, u_maxHeightChange);
        eroded = min(eroded, max(height - (baseHeight - u_maxErosionDepth), 0.0));

        float removedDeposit = min(deposit, eroded * 0.35);
        deposit -= removedDeposit;
        eroded -= removedDeposit;

        height -= eroded;
        newSediment += eroded;
        heightDelta -= eroded;
    }
    else if (newSediment > capacity && u_depositionStrength > 0.0)
    {
        // Concentrate deposition in low-energy spots (flat valley floors, channels,
        // lake beds) instead of smearing a thin film across every slope. On steeper
        // ground the surplus sediment keeps travelling downhill until it reaches a
        // place calm enough to actually settle.
        float flatness = 1.0 - smoothstep(0.015, 0.10, slope);
        float channelArea = clamp(RiverChannelAt(id) * u_riverChannelInfluence, 0.0, 1.0);
        float depositGate = clamp(max(flatness, channelArea), 0.0, 1.0);

        float deposited = min((newSediment - capacity) * u_depositionStrength * depositGate, u_maxHeightChange * 0.35);
        float depositRoom = max(u_maxDepositHeight - deposit, 0.0);
        deposited = min(deposited, depositRoom);

        deposit += deposited;
        newSediment -= deposited;
        // Intentionally do NOT raise the terrain here. Aggradation would flatten the
        // local slope, drop the transport capacity and feed back into even more
        // deposition - the runaway "snowball". Sediment stays a cosmetic layer only.
    }

    // Relax the cosmetic deposit slightly each step so calm areas converge to a stable
    // amount that is continuously replenished by active deposition, instead of
    // accumulating without bound until it suddenly covers everything.
    deposit = max(deposit - deposit * 0.01, 0.0);

    // Thermal weathering / flattening: gravity slowly slides material off steep rock
    // faces down to lower neighbours, washing cliffs and smoothing the terrain. Net
    // change = what slides in from higher neighbours minus what slides out to lower
    // ones, so it is roughly mass conserving and independent of water.
    if (u_flatteningStrength > 0.0)
    {
        float h0 = originalHeight;
        float net = 0.0;
        net += ThermalTransfer(h0, HeightAt(id + ivec2(-1, 0)));
        net += ThermalTransfer(h0, HeightAt(id + ivec2(1, 0)));
        net += ThermalTransfer(h0, HeightAt(id + ivec2(0, -1)));
        net += ThermalTransfer(h0, HeightAt(id + ivec2(0, 1)));
        net += 0.70710678 * ThermalTransfer(h0, HeightAt(id + ivec2(-1, -1)));
        net += 0.70710678 * ThermalTransfer(h0, HeightAt(id + ivec2(1, -1)));
        net += 0.70710678 * ThermalTransfer(h0, HeightAt(id + ivec2(-1, 1)));
        net += 0.70710678 * ThermalTransfer(h0, HeightAt(id + ivec2(1, 1)));

        // 0.07 * total-neighbour-weight (~6.83) keeps the implicit smoothing coefficient
        // below the 0.5 stability bound even at full strength; clamp to the step limit.
        float thermal = clamp(net * u_flatteningStrength * 0.07, -u_maxHeightChange, u_maxHeightChange);
        height += thermal;
    }

    // Height can be cut down by water/thermal erosion and raised by thermal fill in
    // valleys. Deposition is purely cosmetic now, so the upper bound is the symmetric
    // thermal range rather than the tiny deposit limit.
    height = clamp(height, baseHeight - u_maxErosionDepth, baseHeight + u_maxErosionDepth);
    heightDelta = height - originalHeight;

    imageStore(u_heightOut, id, vec4(height, 0.0, 0.0, 0.0));
    imageStore(u_sedimentOut, id, vec4(max(newSediment, 0.0), 0.0, 0.0, 0.0));
    imageStore(u_depositOut, id, vec4(max(deposit, 0.0), 0.0, 0.0, 0.0));
    imageStore(u_erosionDelta, id, vec4(heightDelta, 0.0, 0.0, 0.0));
}
