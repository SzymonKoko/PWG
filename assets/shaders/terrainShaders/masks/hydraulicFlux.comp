#version 450 core

layout (local_size_x = 8, local_size_y = 8) in;

layout (rgba32f, binding = 0) writeonly uniform image2D u_flux;
layout (rgba32f, binding = 1) writeonly uniform image2D u_diagonalFlux;

uniform sampler2D u_height;
uniform sampler2D u_water;
uniform sampler2D u_previousFlux;
uniform sampler2D u_previousDiagonalFlux;
uniform sampler2D u_riverChannels;

uniform int u_size;
uniform float u_pipeFlow;
uniform float u_pipeDamping;
uniform float u_rainRate;
uniform float u_rainElevationBias;
uniform float u_rainMinHeight;
uniform float u_rainMaxHeight;
uniform float u_boundaryDrain;
uniform float u_maxWaterDepth;
uniform float u_riverChannelInfluence;
uniform float u_riverChannelDepth;
uniform float u_flowConcentration;
uniform bool u_useDiagonalFlow;

ivec2 ClampCoord(ivec2 p)
{
    return clamp(p, ivec2(0), ivec2(u_size - 1));
}

float HeightAt(ivec2 p)
{
    return texelFetch(u_height, ClampCoord(p), 0).r;
}

float WaterAt(ivec2 p)
{
    return clamp(texelFetch(u_water, ClampCoord(p), 0).r, 0.0, u_maxWaterDepth);
}

// Rain falls on every cell; elevation bias only boosts high ground.
float RainAt(ivec2 p)
{
    float h = HeightAt(p);
    float heightWeight = smoothstep(u_rainMinHeight, max(u_rainMinHeight + 0.0001, u_rainMaxHeight), h);
    float rainFactor = mix(1.0, heightWeight, clamp(u_rainElevationBias, 0.0, 1.0));
    return u_rainRate * rainFactor;
}

float SurfaceAt(ivec2 p)
{
    p = ClampCoord(p);
    float channelCut = texelFetch(u_riverChannels, p, 0).r * u_riverChannelInfluence * u_riverChannelDepth;
    float water = clamp(WaterAt(p) + RainAt(p), 0.0, u_maxWaterDepth);
    return HeightAt(p) - channelCut + water;
}

vec4 SafeFlux(vec4 value)
{
    if (any(isnan(value)) || any(isinf(value)))
        return vec4(0.0);

    return max(value, vec4(0.0));
}

float PositiveDrop(float fromSurface, float toSurface)
{
    return max(fromSurface - toSurface, 0.0);
}

void main()
{
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    if (id.x >= u_size || id.y >= u_size)
        return;

    float surface = SurfaceAt(id);
    float water = clamp(WaterAt(id) + RainAt(id), 0.0, u_maxWaterDepth);
    vec4 previousFlux = SafeFlux(texelFetch(u_previousFlux, id, 0));
    vec4 previousDiagonalFlux = SafeFlux(texelFetch(u_previousDiagonalFlux, id, 0));

    float pipeFlow = clamp(u_pipeFlow, 0.01, 1.0);
    float pipeDamping = clamp(u_pipeDamping, 0.0, 0.98);

    float leftDrop = PositiveDrop(surface, SurfaceAt(id + ivec2(-1, 0)));
    float rightDrop = PositiveDrop(surface, SurfaceAt(id + ivec2(1, 0)));
    float downDrop = PositiveDrop(surface, SurfaceAt(id + ivec2(0, -1)));
    float upDrop = PositiveDrop(surface, SurfaceAt(id + ivec2(0, 1)));

    float diagonalWeight = u_useDiagonalFlow ? 0.70710678 : 0.0;
    float downLeftDrop = PositiveDrop(surface, SurfaceAt(id + ivec2(-1, -1))) * diagonalWeight;
    float downRightDrop = PositiveDrop(surface, SurfaceAt(id + ivec2(1, -1))) * diagonalWeight;
    float upLeftDrop = PositiveDrop(surface, SurfaceAt(id + ivec2(-1, 1))) * diagonalWeight;
    float upRightDrop = PositiveDrop(surface, SurfaceAt(id + ivec2(1, 1))) * diagonalWeight;

    vec4 pressure = vec4(leftDrop, rightDrop, downDrop, upDrop);
    vec4 diagonalPressure = vec4(downLeftDrop, downRightDrop, upLeftDrop, upRightDrop);

    float concentration = clamp(u_flowConcentration, 0.0, 0.85);
    if (concentration > 0.0001)
    {
        float maxCardinal = max(max(pressure.x, pressure.y), max(pressure.z, pressure.w));
        float maxDiagonal = max(max(diagonalPressure.x, diagonalPressure.y), max(diagonalPressure.z, diagonalPressure.w));
        float maxDrop = max(maxCardinal, maxDiagonal);
        if (maxDrop > 0.000001)
        {
            vec4 cardinalBias = smoothstep(vec4(maxDrop * 0.5), vec4(maxDrop + 0.0001), pressure);
            vec4 diagonalBias = smoothstep(vec4(maxDrop * 0.5), vec4(maxDrop + 0.0001), diagonalPressure);
            pressure = mix(pressure, pressure * cardinalBias, concentration);
            diagonalPressure = mix(diagonalPressure, diagonalPressure * diagonalBias, concentration);
        }
    }

    // Virtual pipes: inertia + pressure-driven outflow (no artificial head clamp).
    vec4 flux = SafeFlux(previousFlux * pipeDamping + pressure * pipeFlow);
    vec4 diagonalFlux = SafeFlux(previousDiagonalFlux * pipeDamping + diagonalPressure * pipeFlow);

    float totalFlux = flux.x + flux.y + flux.z + flux.w
        + diagonalFlux.x + diagonalFlux.y + diagonalFlux.z + diagonalFlux.w;

    if (totalFlux > 0.000001 && water > 0.0)
    {
        float scale = min(1.0, water / totalFlux);
        flux *= scale;
        diagonalFlux *= scale;
    }
    else
    {
        flux = vec4(0.0);
        diagonalFlux = vec4(0.0);
    }

    imageStore(u_flux, id, flux);
    imageStore(u_diagonalFlux, id, diagonalFlux);
}
