#version 450 core

layout (local_size_x = 8, local_size_y = 8) in;
layout (r32f, binding = 0) writeonly uniform image2D u_surfaceOut;
layout (r32f, binding = 1) writeonly uniform image2D u_coverageOut;

uniform sampler2D u_surface;
uniform sampler2D u_coverage;
uniform int u_sourceLevel;
uniform vec2 u_sourceSize;
uniform vec2 u_targetSize;

void main()
{
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(id, ivec2(u_targetSize)))) return;
    ivec2 base = id * 2;
    float weightedSurface = 0.0;
    float weight = 0.0;
    float coverage = 0.0;
    float fallbackSurface = 0.0;
    for (int y = 0; y < 2; ++y)
    {
        for (int x = 0; x < 2; ++x)
        {
            ivec2 p = clamp(base + ivec2(x, y), ivec2(0), ivec2(u_sourceSize) - 1);
            float childCoverage = texelFetch(u_coverage, p, u_sourceLevel).r;
            float childSurface = texelFetch(u_surface, p, u_sourceLevel).r;
            coverage = max(coverage, childCoverage);
            weightedSurface += childSurface * childCoverage;
            weight += childCoverage;
            fallbackSurface += childSurface * 0.25;
        }
    }
    imageStore(u_surfaceOut, id, vec4(weight > 0.00001 ? weightedSurface / weight : fallbackSurface));
    imageStore(u_coverageOut, id, vec4(coverage));
}
