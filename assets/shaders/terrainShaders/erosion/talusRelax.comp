#version 450 core

layout (local_size_x = 8, local_size_y = 8) in;
layout (r32f, binding = 0) writeonly uniform image2D u_heightOut;

uniform sampler2D u_height;
uniform int u_size;
uniform float u_amount;

float HeightAt(ivec2 p)
{
    return texelFetch(u_height, clamp(p, ivec2(0), ivec2(u_size - 1)), 0).r;
}

void main()
{
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(id, ivec2(u_size)))) return;
    if (id.x == 0 || id.y == 0 || id.x == u_size - 1 || id.y == u_size - 1)
    {
        imageStore(u_heightOut, id, vec4(HeightAt(id)));
        return;
    }

    float center = HeightAt(id);
    float talus = mix(0.22, 0.08, u_amount);
    float strength = mix(0.025, 0.10, u_amount);
    float change = 0.0;
    for (int y = -1; y <= 1; ++y)
    {
        for (int x = -1; x <= 1; ++x)
        {
            if (x == 0 && y == 0) continue;
            float distance = (x != 0 && y != 0) ? 1.41421356 : 1.0;
            float difference = center - HeightAt(id + ivec2(x, y));
            float excess = max(abs(difference) - talus * distance, 0.0);
            change -= sign(difference) * excess * strength * 0.125;
        }
    }
    imageStore(u_heightOut, id, vec4(center + change));
}
